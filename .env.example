# Copy to .env and adjust. Every setting is optional for local use.

# Where the SQLite database lives (the Docker image uses /data/openberry.db).
# OPENBERRY_DB=data/openberry.db

# Public URL of the dashboard (used for links in Claude replies and Slack alerts).
OPENBERRY_BASE_URL=http://127.0.0.1:8000

# --- Security: REQUIRED if the dashboard is reachable by anyone but you -------------
# Dashboard login password. Leave empty only when running on 127.0.0.1.
OPENBERRY_PASSWORD=
# Random secret used to sign login sessions:  python -c "import secrets; print(secrets.token_hex(32))"
OPENBERRY_SECRET_KEY=
# Bearer token for the JSON API (/api) and the HTTP MCP endpoint (/mcp).
OPENBERRY_API_TOKEN=
# Comma-separated host names allowed to reach /mcp (besides the one in OPENBERRY_BASE_URL and localhost).
# OPENBERRY_ALLOWED_HOSTS=leads.example.com

# Let anyone fill in the registration form at /register (agency intake). They can't see any data.
OPENBERRY_PUBLIC_REGISTRATION=false

# --- Features --------------------------------------------------------------------
# Run each company's signal scan automatically on its own interval.
OPENBERRY_SCHEDULER=true
# Serve the MCP server over HTTP at /mcp (for Claude Code / remote connectors).
OPENBERRY_HTTP_MCP=true

# Optional free local LLM (https://ollama.com) for "Draft with local AI" in the dashboard.
# OPENBERRY_OLLAMA_URL=http://localhost:11434
# OPENBERRY_OLLAMA_MODEL=llama3.1

# Optional GitHub token (no scopes needed): raises GitHub API limits from 60 to 5000 requests/hour.
# GITHUB_TOKEN=
