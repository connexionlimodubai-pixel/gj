# Copy to .env and adjust. Every setting is optional for local use.
# Keep comments on their own lines. A value that contains " #" must be quoted: PASSWORD="abc #123".

# Where the SQLite database lives. Default: ~/.openberry/openberry.db (the Docker image uses /data/openberry.db).
# This .env file is read from the current directory and from ~/.openberry/.env.
# Two settings only work as real environment variables, because they decide where this file is read from:
# OPENBERRY_HOME moves ~/.openberry, and OPENBERRY_ENV_FILE names the only .env file to read.
# OPENBERRY_DB=/absolute/path/openberry.db

# Public URL of the dashboard (links in Claude replies, allowed Host name; https:// makes login cookies Secure).
# If you run "openberry serve" on another host or port, set this to the address you open in the browser.
OPENBERRY_BASE_URL=http://127.0.0.1:8000

# --- Security: REQUIRED if the dashboard is reachable by anyone but you -------------
# Dashboard login password. Leave empty only when running on 127.0.0.1.
OPENBERRY_PASSWORD=
# Random secret used to sign login sessions:  python -c "import secrets; print(secrets.token_hex(32))"
OPENBERRY_SECRET_KEY=
# Bearer token for the JSON API (/api) and the HTTP MCP endpoint (/mcp).
OPENBERRY_API_TOKEN=
# Comma-separated extra host names to answer to, besides localhost and the host of OPENBERRY_BASE_URL:
# the dashboard and /api in local mode (they also accept IP addresses), and /mcp when no API token is set
# (it accepts no other IP address, so add a LAN IP here to use it). "*" turns the check off.
# OPENBERRY_ALLOWED_HOSTS=leads.example.com

# Let anyone fill in the registration form at /register (agency intake). They can't see any data.
# Their companies arrive paused, without RSS feeds or alert webhooks, until you review and activate them.
OPENBERRY_PUBLIC_REGISTRATION=false

# --- Features --------------------------------------------------------------------
# Run each company's signal scan automatically on its own interval, and send hot-lead alerts for leads
# that turn hot outside a scan (through Claude, the API, a CSV import or an edit).
OPENBERRY_SCHEDULER=true
# How often the scheduler checks for due scans and new hot leads, in seconds (min 30).
# OPENBERRY_SCHEDULER_TICK_SECONDS=300
# Serve the MCP server over HTTP at /mcp (for Claude Code / remote connectors).
OPENBERRY_HTTP_MCP=true

# Optional free local LLM (https://ollama.com) for the "Local AI (Ollama)" writer in the lead page's Draft a message card.
# OPENBERRY_OLLAMA_URL=http://localhost:11434
# OPENBERRY_OLLAMA_MODEL=llama3.1

# Optional GitHub token: raises GitHub API limits from 60 to 5000 requests/hour, and lets the GitHub
# source read stargazers of repos YOU administer (GitHub restricted stargazer lists to repo admins in 2026).
# OPENBERRY_GITHUB_TOKEN works too.
# GITHUB_TOKEN=

# Contact e-mail for APIs that require one in the User-Agent (SEC EDGAR). Falls back to the company's contact e-mail.
# OPENBERRY_CONTACT_EMAIL=you@example.com

# --- Google Maps businesses (optional) ---------------------------------------------
# A Google Maps Platform API key with "Places API (New)" turned on. You can also paste it on the dashboard's API keys page.
# OpenBerry keeps only each business's Place ID from Google; contact details come from the business's own website.
# OPENBERRY_GOOGLE_PLACES_KEY=
# Most Google Maps searches (pages of up to 20 businesses) a month. Google's free tier is 1,000. 0 turns them off.
# OPENBERRY_GOOGLE_PLACES_MONTHLY_LIMIT=900

# Optional Reddit API app (https://www.reddit.com/prefs/apps). Reddit blocks unauthenticated access since 2026
# and requires an agreement for commercial use; the Reddit source is skipped without these.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Your Reddit username, sent in the User-Agent as Reddit requires.
# REDDIT_USERNAME=

# Allow RSS feeds on private/local hosts (e.g. a self-hosted RSSHub at http://localhost:1200). Off by default.
# OPENBERRY_ALLOW_PRIVATE_FEEDS=false
